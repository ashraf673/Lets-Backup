<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lb_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:id="@+id/homePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Let's Backup"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/lb_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your photos. Your memories.\nAlways with you."
                    android:textSize="15sp"
                    android:textColor="@color/lb_text_secondary" />

                <View android:layout_width="match_parent" android:layout_height="24dp" />

                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/ic_logo_lb"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo" />

                <View android:layout_width="match_parent" android:layout_height="28dp" />

                <LinearLayout
                    android:id="@+id/backupCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/card_status"
                    android:padding="20dp"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/card_backup">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="B"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Backup" android:textSize="18sp" android:textStyle="bold"
                            android:textColor="@color/lb_text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Save your photos and videos" android:textSize="13sp"
                            android:textColor="@color/lb_text_secondary" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=">" android:textSize="22sp" android:textColor="@color/lb_primary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="14dp" />

                <LinearLayout
                    android:id="@+id/restoreCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/card_status"
                    android:padding="20dp"
                    android:elevation="3dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/card_restore">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="R"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Restore" android:textSize="18sp" android:textStyle="bold"
                            android:textColor="@color/lb_text_primary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Recover from a backup" android:textSize="13sp"
                            android:textColor="@color/lb_text_secondary" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=">" android:textSize="22sp" android:textColor="@color/lb_primary" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="24dp" />

                <Button
                    android:id="@+id/themeBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Theme: System"
                    style="@style/Widget.Material3.Button.TextButton" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="Simple. Safe. Complete."
                    android:textSize="12sp"
                    android:textColor="@color/lb_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selectionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Select Albums" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="@color/lb_text_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Choose what to back up"
                    android:textSize="14sp" android:textColor="@color/lb_text_secondary" />

                <View android:layout_width="match_parent" android:layout_height="20dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Media type" android:textStyle="bold" android:textColor="@color/lb_text_secondary" />
                <RadioGroup android:id="@+id/mediaTypeGroup" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                    <RadioButton android:id="@+id/radioBoth" android:text="Photos + Videos" android:checked="true"
                        android:textColor="@color/lb_text_primary" />
                    <RadioButton android:id="@+id/radioPhotos" android:text="Photos" android:layout_marginStart="12dp"
                        android:textColor="@color/lb_text_primary" />
                    <RadioButton android:id="@+id/radioVideos" android:text="Videos" android:layout_marginStart="12dp"
                        android:textColor="@color/lb_text_primary" />
                </RadioGroup>

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Date range" android:textStyle="bold" android:textColor="@color/lb_text_secondary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="6dp">
                    <Button android:id="@+id/fromDateBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="From: Any"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                    <Button android:id="@+id/toDateBtn" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="To: Any"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:text="Albums" android:textStyle="bold" android:textColor="@color/lb_text_secondary" />
                    <Button android:id="@+id/selectAllBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Select All" style="@style/Widget.Material3.Button.TextButton" />
                    <Button android:id="@+id/clearAllBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Clear" style="@style/Widget.Material3.Button.TextButton" />
                </LinearLayout>

                <LinearLayout android:id="@+id/albumListContainer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="20dp" />

                <TextView android:id="@+id/sizeText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Selected: 0 files" android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/lb_primary" android:padding="14dp" android:background="@drawable/card_status" />

                <View android:layout_width="match_parent" android:layout_height="20dp" />

                <Button android:id="@+id/startBackupBtn" android:layout_width="match_parent"
                    android:layout_height="56dp" android:text="START BACKUP" android:textSize="16sp" />

                <Button android:id="@+id/backToHomeBtn" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Back"
                    style="@style/Widget.Material3.Button.TextButton" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="24dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/card_status" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="STATUS" android:textSize="11sp" android:textStyle="bold"
                    android:textColor="@color/lb_text_secondary" />
                <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="Ready" android:textSize="14sp"
                    android:textColor="@color/lb_text_primary" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="100dp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/bugReportBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:padding="10dp"
        android:text="Bug"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/lb_primary"
        android:background="#22000000"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/watermarkText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AFC" android:textSize="18sp" android:textStyle="bold"
            android:textColor="#90A4AE" android:letterSpacing="0.15" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ASHRAF CREATION" android:textSize="10sp"
            android:textColor="#90A4AE" android:letterSpacing="0.2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/watermarkProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0.45"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="AFC" android:textSize="48sp" android:textStyle="bold"
            android:textColor="@color/lb_primary" android:letterSpacing="0.15" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ASHRAF CREATION" android:textSize="16sp"
            android:textColor="@color/lb_primary" android:letterSpacing="0.2" />
    </LinearLayout>
</FrameLayout>
