<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lb_background"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/bugReportBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:padding="8dp"
            android:text="Bug"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:background="#22000000"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/homePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/logo_lb">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="LB"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Lets Backup"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/lb_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Portable - Verified - Lossless"
                    android:textSize="13sp"
                    android:textColor="@color/lb_text_secondary" />

                <View android:layout_width="match_parent" android:layout_height="36dp" />

                <LinearLayout
                    android:id="@+id/backupCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_backup"
                    android:padding="24dp"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BACKUP"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Create a verified .lb.zip of your photos and videos"
                        android:textSize="13sp"
                        android:textColor="#E3F2FD" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <LinearLayout
                    android:id="@+id/restoreCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_restore"
                    android:padding="24dp"
                    android:elevation="4dp"
                    android:clickable="true"
                    android:focusable="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESTORE"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Restore from a Lets Backup archive"
                        android:textSize="13sp"
                        android:textColor="#E0F2F1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selectionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select what to backup"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/lb_text_primary" />

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Media type"
                    android:textStyle="bold"
                    android:textColor="@color/lb_text_secondary" />
                <RadioGroup
                    android:id="@+id/mediaTypeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <RadioButton android:id="@+id/radioBoth" android:text="Photos + Videos" android:checked="true" />
                    <RadioButton android:id="@+id/radioPhotos" android:text="Photos" android:layout_marginStart="12dp" />
                    <RadioButton android:id="@+id/radioVideos" android:text="Videos" android:layout_marginStart="12dp" />
                </RadioGroup>

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date range"
                    android:textStyle="bold"
                    android:textColor="@color/lb_text_secondary" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">
                    <Button
                        android:id="@+id/fromDateBtn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="From: Any"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                    <Button
                        android:id="@+id/toDateBtn"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="To: Any"
                        style="@style/Widget.Material3.Button.OutlinedButton" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Albums"
                        android:textStyle="bold"
                        android:textColor="@color/lb_text_secondary" />
                    <Button
                        android:id="@+id/selectAllBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        style="@style/Widget.Material3.Button.TextButton" />
                    <Button
                        android:id="@+id/clearAllBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear"
                        style="@style/Widget.Material3.Button.TextButton" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/albumListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp" />

                <View android:layout_width="match_parent" android:layout_height="20dp" />

                <TextView
                    android:id="@+id/sizeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Selected: 0 files"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/lb_primary"
                    android:padding="12dp"
                    android:background="@drawable/card_status" />

                <View android:layout_width="match_parent" android:layout_height="20dp" />

                <Button
                    android:id="@+id/startBackupBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="START BACKUP"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/backToHomeBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Back"
                    style="@style/Widget.Material3.Button.TextButton" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_status"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/lb_text_secondary" />
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ready"
                    android:textSize="14sp"
                    android:textColor="@color/lb_text_primary" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="60dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:text="Ashraf creation"
            android:textSize="11sp"
            android:textColor="#90A4AE"
            android:alpha="0.85" />
    </FrameLayout>
</ScrollView>
